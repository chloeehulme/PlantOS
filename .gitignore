# Ignore local database files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
**/plants.db

# Ignore build output
bin/
obj/
**/bin/
**/obj/

# Ignore IDE and OS noise
.vs/
.vscode/
.idea/
.DS_Store
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore frontend (ui/) build artifacts and dependencies
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Python (including the MCP server virtual environment)
**/__pycache__/
*.pyc
mcp-server/.venv/
**/.env*
!**/.env.example

# UI-specific logs and editor/project files
ui/**/logs
ui/**/*.log
ui/**/lerna-debug.log*
ui/**/*.ntvs*
ui/**/*.njsproj
ui/**/*.sln
ui/**/*.sw?

# Preserve the UI's explicitly allowed VS Code extensions file
!ui/.vscode/
ui/.vscode/*
!ui/.vscode/extensions.json
